# DigitalOcean Gradient AI Platform Configuration
# Get your MODEL_ACCESS_KEY from: https://cloud.digitalocean.com/agent-platform/serverless-inference

# Required: Your DigitalOcean model access key
MODEL_ACCESS_KEY=your_digitalocean_model_access_key_here

# Optional: Custom model IDs (defaults shown)
GRADIENT_TEXT_MODEL=anthropic-claude-4.5-haiku
GRADIENT_VOICE_MODEL=openai-gpt-4o
GRADIENT_IMAGE_MODEL=openai-gpt-image-1
GRADIENT_EMBEDDING_MODEL=gte-large-v1.5

# Optional: Custom base URL (default: https://inference.do-ai.run/v1/)
# GRADIENT_BASE_URL=https://inference.do-ai.run/v1/

# Server port
PORT=8080
